<div>
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-2xl font-semibold text-gray-900">Notification Templates</h1>
      <p class="mt-2 text-sm text-gray-700">Customize the messages sent to customers</p>
    </div>
  </div>

  <div class="mt-6 space-y-4">
    <% @templates.each do |template| %>
      <div class="bg-white shadow rounded-lg p-6">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-medium text-gray-900"><%= template[:title] %></h3>
          <%= link_to 'Edit', edit_admin_notification_template_path(template[:key]), class: 'text-sm font-medium text-[#10253F] hover:text-[#1a3654]' %>
        </div>
        <div class="mt-4">
          <p class="text-sm font-medium text-gray-500">Push Notification</p>
          <p class="mt-1 text-sm text-gray-900"><%= template[:push_body] %></p>
        </div>
      </div>
    <% end %>
  </div>
</div>
