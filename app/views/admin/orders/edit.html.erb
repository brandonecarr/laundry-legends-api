<div>
  <div class="mb-6">
    <%= link_to '&larr; Back to Order'.html_safe, admin_order_path(@order), class: 'text-sm text-gray-500 hover:text-gray-700' %>
  </div>

  <h1 class="text-2xl font-semibold text-gray-900">Edit Order <%= @order.formatted_order_number %></h1>

  <div class="mt-8 max-w-2xl">
    <%= form_with model: @order, url: admin_order_path(@order), method: :patch, class: "space-y-6" do |f| %>
      <% if @order.errors.any? %>
        <div class="rounded-md bg-red-50 p-4">
          <div class="flex">
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800">There were errors with your submission</h3>
              <div class="mt-2 text-sm text-red-700">
                <ul role="list" class="list-disc space-y-1 pl-5">
                  <% @order.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-medium text-gray-900 mb-4">Pickup Details</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="block text-sm font-medium text-gray-700">Pickup Date</label>
            <%= f.date_field :pickup_date, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#10253F] focus:ring-[#10253F] sm:text-sm' %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Pickup Time Window</label>
            <%= f.collection_select :pickup_time_window_id, TimeWindow.all, :id, :label, { include_blank: 'Select time window' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#10253F] focus:ring-[#10253F] sm:text-sm' %>
          </div>
        </div>
      </div>

      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-medium text-gray-900 mb-4">Delivery Details</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="block text-sm font-medium text-gray-700">Delivery Date</label>
            <%= f.date_field :delivery_date, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#10253F] focus:ring-[#10253F] sm:text-sm' %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Delivery Time Window</label>
            <%= f.collection_select :delivery_time_window_id, TimeWindow.all, :id, :label, { include_blank: 'Select time window' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#10253F] focus:ring-[#10253F] sm:text-sm' %>
          </div>
        </div>
      </div>

      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-medium text-gray-900 mb-4">Order Details</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div>
            <label class="block text-sm font-medium text-gray-700">Bag Count</label>
            <%= f.number_field :bag_count, min: 1, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#10253F] focus:ring-[#10253F] sm:text-sm' %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Subtotal (cents)</label>
            <%= f.number_field :subtotal_cents, min: 0, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#10253F] focus:ring-[#10253F] sm:text-sm' %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Tax (cents)</label>
            <%= f.number_field :tax_cents, min: 0, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#10253F] focus:ring-[#10253F] sm:text-sm' %>
          </div>
        </div>
        <div class="mt-4">
          <label class="block text-sm font-medium text-gray-700">Total (cents)</label>
          <%= f.number_field :total_cents, min: 0, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#10253F] focus:ring-[#10253F] sm:text-sm' %>
          <p class="mt-1 text-xs text-gray-500">Note: Total should equal subtotal + tax</p>
        </div>
      </div>

      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-medium text-gray-900 mb-4">Special Instructions</h2>
        <%= f.text_area :special_instructions, rows: 4, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#10253F] focus:ring-[#10253F] sm:text-sm' %>
      </div>

      <div class="flex justify-end space-x-3">
        <%= link_to 'Cancel', admin_order_path(@order), class: 'rounded-md border border-gray-300 bg-white py-2 px-4 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50' %>
        <%= f.submit 'Save Changes', class: 'rounded-md border border-transparent bg-[#10253F] py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-[#1a3654] cursor-pointer' %>
      </div>
    <% end %>
  </div>
</div>
