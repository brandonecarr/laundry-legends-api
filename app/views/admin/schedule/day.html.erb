<div>
  <div class="mb-6">
    <%= link_to '&larr; Back to Week View'.html_safe, admin_schedule_index_path(date: @date), class: 'text-sm text-gray-500 hover:text-gray-700' %>
  </div>

  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900"><%= @date.strftime('%A, %B %d, %Y') %></h1>
      <p class="mt-1 text-sm text-gray-500"><%= @orders.count %> pickups scheduled</p>
    </div>
    <div class="mt-4 sm:mt-0 flex items-center space-x-4">
      <%= link_to day_admin_schedule_index_path(date: @date - 1.day), class: 'inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50' do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Previous
      <% end %>
      <% if @orders.any? %>
        <%= link_to day_admin_schedule_index_path(date: @date, optimize: true), class: 'inline-flex items-center rounded-md border border-transparent bg-green-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-green-700' do %>
          <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
          Optimize Route
        <% end %>
      <% end %>
      <%= link_to day_admin_schedule_index_path(date: @date + 1.day), class: 'inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50' do %>
        Next
        <svg class="h-5 w-5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      <% end %>
    </div>
  </div>

  <% if @route_result && @route_result[:success] %>
    <!-- Optimized Route Display -->
    <div class="mt-6 bg-green-50 border border-green-200 rounded-lg p-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <svg class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="ml-2 text-sm font-medium text-green-800">Route Optimized</span>
        </div>
        <div class="flex items-center space-x-4 text-sm text-green-700">
          <span><strong><%= @route_stats[:duration] %></strong> min</span>
          <span><strong><%= @route_stats[:distance] %></strong> miles</span>
        </div>
      </div>
      <div class="mt-4">
        <h4 class="text-sm font-medium text-green-800 mb-2">Optimized Order:</h4>
        <ol class="list-decimal list-inside space-y-1">
          <% @optimized_orders.each_with_index do |order, idx| %>
            <li class="text-sm text-green-700">
              <%= link_to order.formatted_order_number, admin_order_path(order), class: 'font-medium hover:underline' %>
              - <%= order.user.full_name %> (<%= order.address&.short_address || 'No address' %>)
            </li>
          <% end %>
        </ol>
      </div>
    </div>
  <% elsif @route_result && !@route_result[:success] %>
    <div class="mt-6 bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex items-center">
        <svg class="h-5 w-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span class="ml-2 text-sm font-medium text-red-800">Route optimization failed: <%= @route_result[:error] %></span>
      </div>
    </div>
  <% end %>

  <!-- Time Windows -->
  <div class="mt-6 space-y-6">
    <% @time_windows.each do |time_window| %>
      <% window_orders = @orders_by_window[time_window.id] || [] %>
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="px-4 py-3 bg-gray-50 border-b border-gray-200">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-medium text-gray-900"><%= time_window.label %></h3>
            <span class="inline-flex items-center rounded-full bg-[#10253F] px-2.5 py-0.5 text-xs font-medium text-white">
              <%= window_orders.count %> orders
            </span>
          </div>
        </div>

        <% if window_orders.any? %>
          <ul role="list" class="divide-y divide-gray-200">
            <% window_orders.each do |order| %>
              <li class="px-4 py-4">
                <div class="flex items-center justify-between">
                  <div class="flex items-center flex-1">
                    <div class="flex-shrink-0">
                      <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= order_status_badge_class(order.status) %>">
                        <%= order.status.humanize %>
                      </span>
                    </div>
                    <div class="ml-4">
                      <p class="text-sm font-medium text-gray-900">
                        <%= link_to order.formatted_order_number, admin_order_path(order), class: 'text-[#10253F] hover:underline' %>
                        - <%= order.user.full_name %>
                      </p>
                      <p class="text-sm text-gray-500">
                        <%= order.address&.short_address || 'No address' %>
                      </p>
                    </div>
                  </div>
                  <div class="flex items-center space-x-4">
                    <% if order.bag_count %>
                      <span class="text-sm text-gray-500"><%= order.bag_count %> bags</span>
                    <% end %>
                    <%= link_to 'View', admin_order_path(order), class: 'text-sm font-medium text-[#10253F] hover:text-[#1a3654]' %>
                  </div>
                </div>
                <% if order.special_instructions.present? %>
                  <div class="mt-2 ml-12">
                    <p class="text-xs text-gray-500"><strong>Note:</strong> <%= truncate(order.special_instructions, length: 100) %></p>
                  </div>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="px-4 py-8 text-center text-sm text-gray-500">
            No pickups scheduled for this time window
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @orders.empty? %>
    <div class="mt-6 text-center py-12 bg-white shadow rounded-lg">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">No pickups scheduled</h3>
      <p class="mt-1 text-sm text-gray-500">There are no pickups scheduled for this day.</p>
    </div>
  <% end %>
</div>
