<div>
  <div class="text-center">
    <h1 class="text-3xl font-bold text-[#10253F]">Laundry Legends</h1>
    <h2 class="mt-2 text-xl font-semibold text-gray-900">Admin Login</h2>
    <p class="mt-2 text-sm text-gray-600">
      Sign in to access the admin dashboard
    </p>
  </div>

  <%= form_with url: admin_login_path, method: :post, class: "mt-8 space-y-6" do |f| %>
    <div class="rounded-md shadow-sm -space-y-px">
      <div>
        <label for="email" class="sr-only">Email address</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-md focus:outline-none focus:ring-[#10253F] focus:border-[#10253F] focus:z-10 sm:text-sm"
          placeholder="Email address"
        >
      </div>
      <div>
        <label for="password" class="sr-only">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
          class="appearance-none rounded-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-b-md focus:outline-none focus:ring-[#10253F] focus:border-[#10253F] focus:z-10 sm:text-sm"
          placeholder="Password"
        >
      </div>
    </div>

    <div>
      <button
        type="submit"
        class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-[#10253F] hover:bg-[#1a3654] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#10253F]"
      >
        Sign in
      </button>
    </div>
  <% end %>
</div>
