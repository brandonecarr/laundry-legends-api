<div>
  <div class="mb-6">
    <%= link_to '&larr; Back to Subscription Plans'.html_safe, admin_subscription_plans_path, class: 'text-sm text-gray-500 hover:text-gray-700' %>
  </div>

  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900"><%= @subscription_plan.name %></h1>
      <p class="mt-1 text-sm text-gray-500">
        <% if @subscription_plan.is_active %>
          <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">Active</span>
        <% else %>
          <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800">Inactive</span>
        <% end %>
      </p>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <%= link_to 'Edit', edit_admin_subscription_plan_path(@subscription_plan), class: 'inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50' %>
      <% if @active_subscribers == 0 %>
        <%= button_to 'Delete', admin_subscription_plan_path(@subscription_plan), method: :delete, data: { confirm: 'Are you sure you want to delete this plan?' }, class: 'inline-flex items-center rounded-md border border-transparent bg-red-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-red-700' %>
      <% end %>
    </div>
  </div>

  <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Plan Details -->
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-medium text-gray-900 mb-4">Plan Details</h2>
        <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <dt class="text-sm font-medium text-gray-500">Monthly Price</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= number_to_currency(@subscription_plan.price_cents / 100.0) %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Bags Per Month</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= @subscription_plan.bags_per_month %></dd>
          </div>
          <% if @subscription_plan.description.present? %>
            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Description</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @subscription_plan.description %></dd>
            </div>
          <% end %>
        </dl>
      </div>

      <!-- Subscribers -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
          <h3 class="text-lg font-medium leading-6 text-gray-900">Subscribers</h3>
          <p class="mt-1 text-sm text-gray-500"><%= @active_subscribers %> active subscribers</p>
        </div>
        <ul role="list" class="divide-y divide-gray-200">
          <% @subscribers.each do |subscription| %>
            <li class="px-4 py-4 sm:px-6">
              <div class="flex items-center justify-between">
                <div class="flex items-center">
                  <div class="h-10 w-10 rounded-full bg-[#10253F] flex items-center justify-center">
                    <span class="text-sm font-medium text-white"><%= subscription.user.first_name[0] %><%= subscription.user.last_name[0] %></span>
                  </div>
                  <div class="ml-4">
                    <p class="text-sm font-medium text-gray-900"><%= subscription.user.full_name %></p>
                    <p class="text-sm text-gray-500"><%= subscription.user.email %></p>
                  </div>
                </div>
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= subscription_status_badge_class(subscription.status) %>">
                  <%= subscription.status.humanize %>
                </span>
              </div>
            </li>
          <% end %>
          <% if @subscribers.empty? %>
            <li class="px-4 py-8 text-center text-sm text-gray-500">
              No subscribers yet
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <!-- Sidebar Stats -->
    <div class="space-y-6">
      <div class="bg-white shadow rounded-lg p-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Statistics</h3>
        <dl class="space-y-4">
          <div>
            <dt class="text-sm font-medium text-gray-500">Total Subscribers</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= Subscription.where(subscription_plan: @subscription_plan).count %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Active Subscribers</dt>
            <dd class="mt-1 text-2xl font-semibold text-green-600"><%= @active_subscribers %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Monthly Revenue</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= number_to_currency(@active_subscribers * @subscription_plan.price_cents / 100.0) %></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</div>
