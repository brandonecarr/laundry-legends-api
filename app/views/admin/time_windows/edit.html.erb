<div>
  <div class="mb-6">
    <%= link_to '&larr; Back to Time Windows'.html_safe, admin_time_windows_path, class: 'text-sm text-gray-500 hover:text-gray-700' %>
  </div>

  <h1 class="text-2xl font-semibold text-gray-900">Edit Time Window</h1>

  <div class="mt-8 max-w-md">
    <%= form_with model: [:admin, @time_window], class: "space-y-6" do |f| %>
      <div class="bg-white shadow rounded-lg p-6">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Label</label>
            <%= f.text_field :label, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#10253F] focus:ring-[#10253F] sm:text-sm' %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Start Time</label>
            <%= f.time_field :start_time, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#10253F] focus:ring-[#10253F] sm:text-sm' %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">End Time</label>
            <%= f.time_field :end_time, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[#10253F] focus:ring-[#10253F] sm:text-sm' %>
          </div>
        </div>
      </div>

      <div class="flex justify-end space-x-3">
        <%= link_to 'Cancel', admin_time_windows_path, class: 'rounded-md border border-gray-300 bg-white py-2 px-4 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50' %>
        <%= f.submit 'Update Time Window', class: 'rounded-md border border-transparent bg-[#10253F] py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-[#1a3654] cursor-pointer' %>
      </div>
    <% end %>
  </div>
</div>
